{
  "manifest_version": 3,
  "name": "JobTrack",
  "version": "1.0.0",
  "description": "Track and manage job applications directly from your browser.",
  "action": {
    "default_popup": "index.html",
    "default_title": "JobTrack",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}